APP_NAME="SiWali"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://jti.polije.ac.id/siwali
ASSET_URL=https://jti.polije.ac.id/siwali

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=10.0.0.20
DB_PORT=3306
DB_DATABASE=siwali
DB_USERNAME=siwali_app
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=10.0.0.20
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/siwali
SESSION_COOKIE=siwali_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=siwali_
REDIS_PREFIX=siwali_
QUEUE_CONNECTION=redis

RABBITMQ_HOST=10.0.0.20
RABBITMQ_PORT=5672
RABBITMQ_USER=siwali
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=notification_queue

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

SUPER_APP_URL=https://jti.polije.ac.id/api/v1
SUPER_APP_URL_INTERNAL=http://10.0.0.20:8000/api/v1
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
INTERSERVICE_API_KEY=
JTIFORM_SERVICE_URL=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
