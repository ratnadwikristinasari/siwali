# Source control
.git
.gitignore

# Composer & NPM dependencies
# Usually installed inside the Dockerfile during the build
vendor/
node_modules/

# Environment and sensitive data
.env
# .env.*
!.env.example
*.key

# Laravel Logs and Cache
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*.php
storage/framework/testing/*

# Testing and development artifacts
.phpunit.result.cache
tests/
phpunit.xml
.idea/
.vscode/

# Docker-related files
Dockerfile
docker-compose*.yml
.dockerignore

# FrankenPHP binary yang ter-download oleh composer (163MB!)
# Binary asli sudah ada di base image /usr/local/bin/frankenphp
frankenphp

# Deployment manifests — tidak perlu di image
k8s/

# Development docs
PRD.md
AGENTS.md
README.md
*.md

# Env files sensitif (jangan masuk build context)
# .env.staging
.env.production
.env.local

# Package lock files — JANGAN diignore, dibutuhkan oleh build stages
# package-lock.json → npm ci --frozen-lockfile di build-js stage
# composer.lock    → composer install di builder stage

